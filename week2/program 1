    color: #333;
    margin: 20px;
}
label {
    font-weight: bold;
    display: block;
    margin: 10px 0 5px 20px;
}
select {
    padding: 5px;
    margin-left: 20px;
}
button {
    background-color: #ff0066;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 6px;
    margin-left: 20px;
    margin-top: 10px;
}



