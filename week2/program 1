<!DOCTYPE html>
<html>
<head>
    <title>Inline CSS Movie Booking</title>
</head>
<body>
    <h1 style="color: blue; text-align: center;">WTMA Movie Booking</h1>
    <p style="font-size: 18px; color: green;">
        Book your favorite movie tickets easily using Inline CSS.
    </p>
    <label style="font-weight: bold;">Select Movie:</label>
    <select style="padding: 5px; margin: 10px;">
        <option>Avengers</option>
        <option>Inception</option>
        <option>Interstellar</option>
    </select>
    <br>
    <button style="background: orange; padding: 10px; border: none; margin-top: 10px;">
        Book Now
    </button>
</body>
</html>


<!DOCTYPE html>
<html>
<head>
    <title>Internal CSS Movie Booking</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f0f8ff;
        }
        h1 {
            color: darkred;
            text-align: center;
            margin-top: 20px;
        }
        p {
            font-size: 18px;
            color: navy;
            margin: 20px;
        }
        label {
            font-weight: bold;
            display: block;
            margin: 10px 0 5px 20px;
        }
        select {
            padding: 5px;
            margin-left: 20px;
        }
        button {
            background-color: green;
            color: white;
            padding: 10px 15px;
            border: none;
            border-radius: 5px;
            margin-left: 20px;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <h1>WTMA Movie Booking</h1>
    <p>Book your movie tickets using Internal CSS styling.</p>
    <label>Select Movie:</label>
    <select>
        <option>Avengers</option>
        <option>Inception</option>
        <option>Interstellar</option>
    </select>
    <br>
    <button>Book Now</button>
</body>
</html>


<!DOCTYPE html>
<html>
<head>
    <title>External CSS Movie Booking</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h1>WTMA Movie Booking</h1>
    <p>Book your tickets with styling from an External CSS file.</p>
    <label>Select Movie:</label>
    <select>
        <option>Avengers</option>
        <option>Inception</option>
        <option>Interstellar</option>
    </select>
    <br>
    <button>Book Now</button>
</body>
</html>

body {
    font-family: Verdana, sans-serif;
